# 测试管理平台(TMS)后端配置模板
# 复制为 .env 后填入真实值

# ===== MySQL(复用项目一所在 MySQL 实例)=====
TMS_DB_HOST=127.0.0.1
TMS_DB_PORT=3307
TMS_DB_USER=root
TMS_DB_PASSWORD=root123
TMS_DB_NAME=test_platform

# ===== 项目一 pytest-realworld-framework 路径(执行器将 import 其 api/utils)=====
PYTEST_FRAMEWORK_PATH=F:/pytest-realworld-framework

# ===== 被测后端默认地址(创建任务时"环境"的默认值)=====
TMS_DEFAULT_BASE_URL=http://localhost:8080/api

# ===== 通义千问(根因分析;不填则跳过 AI 分析)=====
DASHSCOPE_API_KEY=
TMS_AI_MODEL=qwen-plus

# ===== CORS 允许的前端地址 =====
TMS_CORS_ORIGINS=http://localhost:5173
